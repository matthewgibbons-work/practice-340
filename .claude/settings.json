{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "outputStyle": "Learning",
  "permissions": {
    "deny": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git mv:*)",
      "Bash(git reset:*)",
      "Bash(git checkout:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/scope-guard.mjs"
          }
        ]
      }
    ]
  }
}
