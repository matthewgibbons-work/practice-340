---
// Every NOTES.md, grouped into Sparks and Prototypes, at build time.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { url } from '../../lib/url.js';

// The loader reads folders with readdir, which promises no order, so we sort by folder name here.
const notes = (await getCollection('notes')).sort((a, b) => a.id.localeCompare(b.id));

const groups = [
  { kind: 'sparks', heading: 'Sparks' },
  { kind: 'prototypes', heading: 'Prototypes' },
];
---

<Base title="Notes" current="notes/">
  <h1>Notes</h1>
  <p>One page for each Spark and Prototype: what I built, how I used AI, and what I learned.</p>
  {
    groups.map((group) => (
      <section aria-labelledby={group.kind}>
        <h2 id={group.kind}>{group.heading}</h2>
        <ul>
          {notes
            .filter((note) => note.data.kind === group.kind)
            .map((note) => (
              <li>
                <a href={url(`notes/${note.id}/`)}>{note.data.title}</a>
              </li>
            ))}
        </ul>
      </section>
    ))
  }
</Base>
