---
// Runs at build time, on my computer or in the GitHub Action, never in the visitor's browser.
import Base from '../layouts/Base.astro';

const names = ['pikachu', 'bulbasaur', 'eevee', 'snorlax'];

async function fetchPokemon(name) {
  const response = await fetch(`https://pokeapi.co/api/v2/pokemon/${name}`);
  // A 404 or 500 stops the build with a message, instead of shipping a page with a hole in it.
  if (!response.ok) {
    throw new Error(`PokéAPI answered ${response.status} for "${name}"`);
  }
  const data = await response.json();
  return {
    id: data.id,
    name: data.name,
    sprite: data.sprites.front_default,
    types: data.types.map((t) => t.type.name),
  };
}

const party = await Promise.all(names.map(fetchPokemon));
---

<Base title="My party" current="party/">
  <h1>My party</h1>
  <p>{party.length} Pokémon, fetched from PokéAPI when this site was built.</p>
  <ul class="party">
    {
      party.map((member) => (
        <li>
          <img src={member.sprite} alt="" width="96" height="96" />
          <h2>{member.name}</h2>
          <p>No. {member.id} · {member.types.join(' / ')}</p>
        </li>
      ))
    }
  </ul>
</Base>

<style>
  .party {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
    gap: 1rem;
    padding: 0;
    list-style: none;
  }
  .party li {
    padding: 0.75rem;
    border: 1px solid currentColor;
    border-radius: 0.5rem;
    text-align: center;
  }
  h2 {
    margin: 0;
    text-transform: capitalize;
  }
  img {
    image-rendering: pixelated;
  }
</style>
